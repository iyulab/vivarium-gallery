<?xml version="1.0" encoding="utf-8"?>
<!--
  This sample reproduces a real consumer, and a real consumer restores from nuget.org
  alone. Without this file, a machine-level package source that holds a build under an
  already-published version number wins the restore, and the host runs bits the registry
  never served. host/tools/verify-consumption.ts (axis 6) reports where each restored
  package came from.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
